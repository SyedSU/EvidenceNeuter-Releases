{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "channel",
    "platform",
    "version",
    "sequence",
    "expires",
    "minimumHubVersion",
    "saveSchema",
    "sourceCommit",
    "packages"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "product": {
      "const": "genesis"
    },
    "channel": {
      "const": "stable"
    },
    "platform": {
      "const": "windows-x64"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "expires": {
      "type": "string",
      "format": "date-time"
    },
    "minimumHubVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "saveSchema": {
      "type": "integer",
      "minimum": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url",
          "size",
          "sha256",
          "files"
        ],
        "properties": {
          "kind": {
            "enum": [
              "game",
              "runtime",
              "model"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967296
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "size",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967296
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
